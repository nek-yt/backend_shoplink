# Copy this file to .env and fill in the values.

# development | production
NODE_ENV=development
PORT=4000

# REQUIRED in production. Use a long random string, e.g. run:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# PostgreSQL connection: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Hosted databases (Render, Railway, Neon, Supabase...) give you this URL; add ?sslmode=require if they ask for SSL.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/shoplink
# Optional: database for `npm test` (tests use a temporary schema and delete it afterwards)
TEST_DATABASE_URL=
# Optional: data folder of a local PostgreSQL; `npm run dev` starts it automatically if it is down
PGDATA=

# Admin account created on first start (REQUIRED in production)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@shoplink.com
ADMIN_PASSWORD=change-me-please

# Telegram bot token from @BotFather (enables Telegram login). Leave empty to disable.
TELEGRAM_BOT_TOKEN=

# "Log in with TikTok": app from https://developers.tiktok.com (Login Kit for Web).
# The redirect URI is a page of your website and must be registered in the TikTok app exactly as written here.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# "Log in with Instagram": Meta app with "Instagram API with Instagram Login" (professional accounts only).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=

# Allowed frontend origins, comma separated, or * for any
CORS_ORIGIN=*

# Set to 1 when running behind a reverse proxy / hosting platform (Render, Railway, Nginx...)
TRUST_PROXY=false

# Max login/register attempts per IP per 15 minutes (0 = no limit)
AUTH_RATE_LIMIT=30

# Time zone that "today" means in GET /api/users/stats.
STATS_TIME_ZONE=Asia/Tashkent

# Where uploaded product pictures and profile pictures are saved (served at /api/uploads/...).
UPLOAD_DIR=uploads
